{
  "subscriptionId": "<app-subscription-guid>",
  "location": "southcentralus",
  "resourceGroup": "rg-session-scribe",
  "nameSuffix": "<4-8 lowercase letters/digits, makes global names unique>",
  "storage": {
    "subscriptionId": "<storage-subscription-guid (may be another tenant)>",
    "resourceGroup": "rg-session-scribe-storage",
    "location": "southcentralus",
    "accountName": "<globally-unique-storage-account-name>",
    "speechContainer": "speech-input",
    "budgetMonthlyUsd": 10
  },
  "ai": {
    "resourceGroup": "<ai-account-resource-group>",
    "accountName": "<ai-account-name>",
    "speechEndpoint": "https://<ai-account>.cognitiveservices.azure.com",
    "openaiEndpoint": "https://<ai-account>.openai.azure.com",
    "openaiDeployment": "session-scribe-recap",
    "reasoningEffort": "low"
  },
  "app": {
    "name": "session-scribe",
    "cpu": 1.0,
    "memory": "2Gi",
    "adminEmail": "",
    "publicOrigin": "",
    "budgetMonthlyUsd": 40,
    "aiBudgetMonthlyUsd": 50
  }
}
