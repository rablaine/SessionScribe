{
  "name": "dnd-session-scribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:gateway": "node dist/gateway-server.js",
    "check": "tsc --noEmit",
    "laughter:model": "python detector/download_model.py",
    "laughter:detect": "python detector/detect_laughter.py",
    "test:laughter": "python -m unittest discover -s detector -p \"test_*.py\"",
    "users:bootstrap": "tsx src/account-cli.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.28.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
