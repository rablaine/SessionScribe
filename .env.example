# Copy to .env. Never put private credentials in browser code.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Optional reserved administrator email. The bootstrap CLI creates its actual role.
# No password belongs in this file. Run npm run users:bootstrap -- --email YOUR_EMAIL.
APP_ADMIN_EMAIL=
# Optional HTTPS base for future invitation/reset links. Blank uses localhost.
# Public hosting remains disabled until separately configured and verified.
APP_PUBLIC_ORIGIN=
AZURE_SPEECH_ENDPOINT=https://YOUR-SPEECH-RESOURCE.cognitiveservices.azure.com
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE-ACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=dnd-audio
# Optional narrow gateway; leave BOTH blank for direct Blob upload/delete.
# HTTPS App Service root only. Token scope is the gateway API, NOT Azure AI.
AZURE_STORAGE_GATEWAY_URL=
AZURE_STORAGE_GATEWAY_SCOPE=
# Resource root, NOT the Foundry project endpoint or a deployment URL.
AZURE_OPENAI_ENDPOINT=https://YOUR-OPENAI-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=session-scribe-recap
# Recommended: a GPT-5.4 deployment. Set effort only on models supporting it.
# Leave blank for non-reasoning models such as GPT-4o.
AZURE_OPENAI_REASONING_EFFORT=low
# Reasoning models use this allowance for both internal reasoning and output.
AZURE_OPENAI_MAX_COMPLETION_TOKENS=16000
# Explicit auth mode: certificate (local SP), managed-identity (Azure), or azure-cli.
# No fallback to the administrator's CLI login if the SP fails.
AZURE_AUTH_MODE=certificate
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_CERTIFICATE_PATH=./.secrets/dnd-session-scribe.pem
# Executables on PATH, or absolute paths. Install both for real uploads.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# YAMNet runs in a separate Python process locally and in the future worker container.
# Install detector/requirements.txt and run detector/download_model.py before processing.
LAUGHTER_DETECTION_ENABLED=true
PYTHON_PATH=python
YAMNET_MODEL_PATH=./detector/models/yamnet
LAUGHTER_DETECTOR_SCRIPT=./detector/detect_laughter.py
LAUGHTER_HIGH_THRESHOLD=0.15
LAUGHTER_LOW_THRESHOLD=0.05
LAUGHTER_TIMEOUT_MINUTES=60

# GATEWAY PROCESS ONLY (npm run start:gateway / node dist/gateway-server.js).
# Set these in App Service, not required for the local UI. Gateway binds 0.0.0.0,
# defaults PORT to 8080 when unset, and uses system-assigned managed identity only.
# Its storage account/container settings above must match the local app.
# GATEWAY_TENANT_ID=your-tenant-guid
# GATEWAY_AUDIENCE=your-gateway-api-client-guid
# GATEWAY_CALLER_CLIENT_ID=your-local-app-client-guid
# GATEWAY_CALLER_OBJECT_ID=your-local-service-principal-object-guid
